# Copiar a apps/api/.env en la instancia EC2 (nunca commitear el real).
#
# DATABASE_URL: endpoint de tu instancia RDS (Configuración > Endpoint en
# la consola de AWS), no localhost.
DATABASE_URL="postgresql://sharegrams_app:CAMBIAR_ESTA_PASSWORD@tu-instancia.xxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/sharegrams"

# Generar uno nuevo y largo para producción, nunca reusar el de desarrollo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIAR_ESTO"
JWT_EXPIRES_IN="7d"

PORT=3000

# Opcional -- solo si vas a probar el asistente de IA (Fases 5-7) en producción.
# ANTHROPIC_API_KEY="sk-ant-..."
